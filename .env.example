# Watahub Gateway Configuration

# Port for local Node execution
PORT=3000

# Meta Developers App Credentials
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_API_VERSION=v24.0

# Meta Webhook Verification (min 16 characters)
META_WEBHOOK_VERIFY_TOKEN=your_secure_verify_token_here

# Watahub Security
# API key required for every /v1/* and /v24.0/* call (the gateway refuses to serve them without it).
# Generate with: openssl rand -hex 32  (min 32 characters)
WATAHUB_API_KEY=

# Subscribers Webhook Dispatch
# Where to forward verified inbound Meta events (e.g. https://app.cautia.com/api/webhooks/whatsapp)
SUBSCRIBER_WEBHOOK_URL=
# Required when SUBSCRIBER_WEBHOOK_URL is set (min 32 characters, openssl rand -hex 32)
SUBSCRIBER_WEBHOOK_SECRET=

# Webhook replay window (optional)
# Signed Meta deliveries whose newest event is older than this are acknowledged but not forwarded.
# Default 604800 (7 days, Meta's retry horizon). A body the subscriber already confirmed is not forwarded again.
META_WEBHOOK_MAX_AGE_SECONDS=

# Rate limiting (optional)
# Wrong API keys / verify tokens get 429 after 10 failures per client per minute (a correct key always passes).
# Set a number to also cap all /v1 and /v24.0 requests per client per minute.
RATE_LIMIT_PER_MINUTE=
# Behind a reverse proxy on Node, name the header that carries the real client IP (e.g. X-Real-IP).
# Leave empty on Cloudflare Workers (CF-Connecting-IP is used) or when Node is exposed directly.
TRUSTED_CLIENT_IP_HEADER=

# CORS (optional, off by default)
# Comma-separated exact origins allowed to call the API from a browser. No wildcards.
CORS_ALLOWED_ORIGINS=
