{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watahub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  // Line tokens from POST /v1/onboarding/connect. Without this binding, connect answers 503 on Workers.
  // Create the namespace with `pnpm exec wrangler kv namespace create WATAHUB_KV`, put the printed id
  // below and uncomment the block. A placeholder id makes `wrangler deploy` fail.
  // "kv_namespaces": [
  //   {
  //     "binding": "WATAHUB_KV",
  //     "id": "<id printed by pnpm exec wrangler kv namespace create WATAHUB_KV>"
  //   }
  // ],
  "routes": [
    {
      "pattern": "api.watahub.dev",
      "custom_domain": true
    }
  ]
}
