{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watahub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  // Line tokens from POST /v1/onboarding/connect. Without this binding, connect answers 503 on Workers.
  // This id is Hub Ventures' namespace: for your own deploy, create one with
  // `pnpm exec wrangler kv namespace create WATAHUB_KV` and put its id here.
  "kv_namespaces": [
    {
      "binding": "WATAHUB_KV",
      "id": "3e7bbf20ad4a4942acb0dd80d27721fe"
    }
  ],
  "routes": [
    {
      "pattern": "api.watahub.dev",
      "custom_domain": true
    }
  ]
}
